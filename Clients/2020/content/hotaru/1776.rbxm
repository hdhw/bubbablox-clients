					<string name="Name">HarmonicaSounds</string>
					<string name="ScriptGuid"></string>
					<ProtectedString name="Source"><![CDATA[-- LOL

function isWorn()
	return script.Parent.Parent.Parent:FindFirstChild("Humanoid") ~= nil
end

while true do

	wait(math.random(5,20))

	if (isWorn()) then

		local name = "Harm" .. math.random(1,4)

		script.Parent:FindFirstChild(name):Play()
	end

end]]></ProtectedString>
